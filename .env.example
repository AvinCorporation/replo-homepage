# Replo live environment variables
# Never commit real secret values.

# Supabase project used for diagnosis submissions, auth, and portal data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://replo.kr

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
INTEGRATION_ENCRYPTION_KEY=

# Required in Preview and Production for diagnosis rate limiting.
# Upstash Redis integration variables are preferred. Legacy Vercel KV aliases
# KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-only diagnosis webhook. Do not prefix with NEXT_PUBLIC_.
DIAGNOSIS_WEBHOOK_URL=
DIAGNOSIS_WEBHOOK_SECRET=

# 토스페이먼츠 빌링(자동결제) 카드 등록.
# 클라이언트 키는 인증창을 여는 데만 쓰이고, 시크릿 키는 서버에서 빌링키를
# 발급받을 때만 씁니다. 발급된 빌링키는 INTEGRATION_ENCRYPTION_KEY로 암호화해
# 저장하므로 두 값이 함께 설정되어 있어야 합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Meta Pixel + Conversions API.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
